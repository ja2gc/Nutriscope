# ─── Development modes ───────────────────────────────────────────────────────
#
# Option A — LAN (phone + PC on same network, Laravel running natively)
#   Find your PC's LAN IP: ipconfig (Windows) / ifconfig (Mac/Linux)
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
#
# Option B — Production API (test against the live Laravel backend)
#   EXPO_PUBLIC_API_URL=https://api.nutriscope.live
#
# Option C — Backend tunnel (ngrok/cloudflared exposing local Laravel)
#   EXPO_PUBLIC_API_URL=https://<your-tunnel-subdomain>.ngrok.io
#
# NOTE: `npx expo start --tunnel` tunnels the JS bundle only.
#       It does NOT make a local Laravel backend reachable from your phone.
#       For phone-to-local-backend, use Option A (LAN) or Option C (tunnel the backend).
#
# ─────────────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
