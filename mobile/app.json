{
  "expo": {
    "name": "Nutriscope FSS",
    "slug": "nutriscope-fss",
    "version": "1.2.4",
    "platforms": ["android", "ios"],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "nutriscope-fss",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2"
    },
    "android": {
      "package": "live.nutriscope.fss",
      "versionCode": 8,
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "adaptiveIcon": {
        "backgroundColor": "#0B6B4B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NutriScope needs access to your photos so you can attach receipts and proof-of-purchase images to vendor deliveries.",
          "cameraPermission": "NutriScope needs camera access so you can photograph receipts and proof of purchase for vendor deliveries."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c285e45f-75fb-4866-b52a-9ea1d6d7913f"
      }
    }
  }
}
