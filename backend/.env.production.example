# Production environment legend:
# KEEP AS SHOWN      — working default for the current NutriScope deployment.
# REQUIRED           — replace the blank or example value before deployment.
# REQUIRED SECRET    — provide through the protected production environment; never commit it.
# OPTIONAL           — blank or null is valid; fill only when the related feature/provider is used.
# LEAVE BLANK        — unused by the current production path; keep empty unless the mailer changes.
# CONDITIONAL        — required only when the named driver or feature is enabled.
# PLATFORM-SPECIFIC  — keep for nutriscope.live; replace when domain, host, or provider changes.

# KEEP AS SHOWN
APP_NAME=NutriScope
APP_ENV=production
# REQUIRED SECRET — generate once for a new installation; preserve it during ordinary deployments or server moves.
APP_KEY=
# KEEP AS SHOWN
APP_DEBUG=false
# KEEP AS SHOWN for nutriscope.live. PLATFORM-SPECIFIC when the public URL changes.
APP_URL=https://nutriscope.live

# KEEP AS SHOWN
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# KEEP AS SHOWN for bundled Docker MySQL. PLATFORM-SPECIFIC for managed MySQL.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nutriscope
DB_USERNAME=root
# REQUIRED SECRET
DB_PASSWORD=
# KEEP AS SHOWN
DB_DUMP_SKIP_SSL=false
DB_DUMP_SSL_FLAG=skip-ssl

# KEEP AS SHOWN except SESSION_DOMAIN, which is PLATFORM-SPECIFIC.
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nutriscope.live
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# KEEP AS SHOWN
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1260

CACHE_STORE=redis
CACHE_PREFIX=nutriscope_

# KEEP AS SHOWN for bundled Docker Redis. PLATFORM-SPECIFIC for managed Redis.
REDIS_CLIENT=predis
REDIS_HOST=redis
# OPTIONAL — keep null for bundled Redis; use the managed Redis password when required.
REDIS_PASSWORD=null
REDIS_PORT=6379

# KEEP AS SHOWN — production sends mail through the Resend HTTPS API.
MAIL_MAILER=resend-api
# LEAVE BLANK — SMTP-only settings are unused by resend-api.
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_EHLO_DOMAIN=
# KEEP AS SHOWN for the current verified sender. PLATFORM-SPECIFIC when the sender/domain changes.
MAIL_FROM_ADDRESS="no-reply@nutriscope.live"
# KEEP AS SHOWN
MAIL_FROM_NAME="${APP_NAME}"
# REQUIRED SECRET
RESEND_API_KEY=
# KEEP AS SHOWN
RESEND_API_ENDPOINT=https://api.resend.com/emails

# OPTIONAL SECRETS — leave blank when the related external feature is not configured.
ANTHROPIC_API_KEY=
# KEEP AS SHOWN
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPTIONAL SECRET
USDA_API_KEY=

# KEEP AS SHOWN. OPTIONAL threshold remains blank unless an operator sets one.
# The database row becomes authoritative for retention after the first Admin toggle.
AUDIT_DATABASE_DISK_USED_PERCENT=
AUDIT_RETENTION_ENABLED=false
AUDIT_EXPORT_ENABLED=false

# KEEP AS SHOWN for nutriscope.live. PLATFORM-SPECIFIC when the public domain changes.
FRONTEND_URL=https://nutriscope.live
SANCTUM_STATEFUL_DOMAINS=nutriscope.live,www.nutriscope.live
# KEEP AS SHOWN
VITE_APP_NAME="${APP_NAME}"

# KEEP AS SHOWN for current local-volume upload storage.
UPLOADS_DISK=public
# OPTIONAL — leave blank when APP_URL serves public uploads.
UPLOADS_PUBLIC_URL=
PRIVATE_UPLOADS_DISK=private_uploads
# KEEP AS SHOWN for current single-VPS persistent volume. Change to s3 only after object storage is configured.
PRIVATE_UPLOADS_DRIVER=local
# CONDITIONAL — required only when PRIVATE_UPLOADS_DRIVER=s3.
PRIVATE_UPLOADS_ACCESS_KEY_ID=
PRIVATE_UPLOADS_SECRET_ACCESS_KEY=
PRIVATE_UPLOADS_REGION=auto
PRIVATE_UPLOADS_BUCKET=
PRIVATE_UPLOADS_ENDPOINT=
PRIVATE_UPLOADS_USE_PATH_STYLE_ENDPOINT=false

# KEEP AS SHOWN for production backup behavior.
BACKUP_DISK=backups
BACKUP_FILESYSTEM_DRIVER=s3
BACKUP_NAME=nutriscope-database
BACKUP_QUEUE=backups
BACKUP_TIMEZONE=Asia/Manila
# REQUIRED SECRET/VALUES for production backups.
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_DEFAULT_REGION=auto
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=
# OPTIONAL — leave blank to use MAIL_FROM_ADDRESS for backup alerts.
BACKUP_ALERT_EMAIL=
# KEEP AS SHOWN until the temporary-database recovery workflow is explicitly enabled.
BACKUP_RESTORE_ENABLED=false
