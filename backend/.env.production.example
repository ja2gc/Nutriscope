APP_NAME=NutriScope
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://nutriscope.live

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# DB — service name on the Docker network. Swap host/credentials here to use managed MySQL.
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=nutriscope
DB_USERNAME=root
DB_PASSWORD=
DB_DUMP_SKIP_SSL=false
DB_DUMP_SSL_FLAG=skip-ssl

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.nutriscope.live
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=1260

CACHE_STORE=redis
CACHE_PREFIX=nutriscope_

# Redis — service name on the Docker network. Swap host here to use managed Redis.
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USERNAME=resend
MAIL_PASSWORD=re_your_resend_api_key_here
MAIL_EHLO_DOMAIN=nutriscope.live
MAIL_FROM_ADDRESS="no-reply@nutriscope.live"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
USDA_API_KEY=

AI_DAILY_TOKEN_LIMIT=100000

# Audit controls. Keep both feature fallbacks disabled until explicitly approved.
# The database row becomes authoritative for retention after the first Admin toggle.
AUDIT_DATABASE_DISK_USED_PERCENT=
AUDIT_RETENTION_ENABLED=false
AUDIT_EXPORT_ENABLED=false

FRONTEND_URL=https://nutriscope.live
SANCTUM_STATEFUL_DOMAINS=nutriscope.live,www.nutriscope.live
VITE_APP_NAME="${APP_NAME}"

# Set these in the hosting platform's secret store, never in Git.
UPLOADS_DISK=public
UPLOADS_PUBLIC_URL=
PRIVATE_UPLOADS_DISK=private_uploads
# Current single-Droplet deployment uses the persistent private-upload volume.
# Change to s3 only after a private object-storage provider is configured.
PRIVATE_UPLOADS_DRIVER=local
PRIVATE_UPLOADS_ACCESS_KEY_ID=
PRIVATE_UPLOADS_SECRET_ACCESS_KEY=
PRIVATE_UPLOADS_REGION=auto
PRIVATE_UPLOADS_BUCKET=
PRIVATE_UPLOADS_ENDPOINT=
PRIVATE_UPLOADS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_DISK=backups
BACKUP_FILESYSTEM_DRIVER=s3
BACKUP_NAME=nutriscope-database
BACKUP_QUEUE=backups
BACKUP_TIMEZONE=Asia/Manila
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_DEFAULT_REGION=auto
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ALERT_EMAIL=
