# Dependencies (reinstalled in image)
/vendor
/node_modules

# Env & secrets — never bake into the image
.env
.env.*
!.env.example

# VCS / tooling
.git
.gitignore
.gitattributes
.github

# Laravel runtime / caches
/public/storage
/storage/app/*
/storage/*.key
/storage/logs/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
bootstrap/cache/*.php

# Tests & local dev
/tests
phpunit.xml
.phpunit.result.cache
/.idea
/.vscode

# Build / CI artifacts
*.log
docker-compose*.yml
Dockerfile
.dockerignore
