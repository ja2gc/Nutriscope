APP_NAME=NutriScope
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Infrastructure-provided database volume usage (0-100); leave blank if unavailable.
AUDIT_DATABASE_DISK_USED_PERCENT=
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev: reach the Dockerized infra via published localhost ports.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutriscope
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=960

CACHE_STORE=redis
CACHE_PREFIX=nutriscope_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default writes emails to storage/logs/laravel.log. Use smtp for real inbox delivery.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nutriscope.local"
MAIL_FROM_NAME="${APP_NAME}"

# Resend SMTP example:
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtps
# MAIL_HOST=smtp.resend.com
# MAIL_PORT=465
# MAIL_USERNAME=resend
# MAIL_PASSWORD=re_your_resend_api_key_here
# MAIL_EHLO_DOMAIN=nutriscope.live
# MAIL_FROM_ADDRESS="no-reply@nutriscope.live"
# RESEND_API_KEY=

# NutriScope Integrations
# Get your key from: https://platform.anthropic.com/
ANTHROPIC_API_KEY=

# Get your key from: https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=

# AI Limits
AI_DAILY_TOKEN_LIMIT=100000

# Audit controls. Production enablement requires recorded owner approval.
AUDIT_RETENTION_ENABLED=false
AUDIT_EXPORT_ENABLED=false

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Sanctum stateful domains for local dev
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

VITE_APP_NAME="${APP_NAME}"

# Provider-neutral uploads and private database backups
UPLOADS_DISK=public
UPLOADS_PUBLIC_URL=
PRIVATE_UPLOADS_DISK=private_uploads
PRIVATE_UPLOADS_DRIVER=local
PRIVATE_UPLOADS_ACCESS_KEY_ID=
PRIVATE_UPLOADS_SECRET_ACCESS_KEY=
PRIVATE_UPLOADS_REGION=auto
PRIVATE_UPLOADS_BUCKET=
PRIVATE_UPLOADS_ENDPOINT=
PRIVATE_UPLOADS_USE_PATH_STYLE_ENDPOINT=false
BACKUP_DISK=backups
BACKUP_FILESYSTEM_DRIVER=s3
BACKUP_NAME=nutriscope-database
BACKUP_QUEUE=backups
BACKUP_TIMEZONE=Asia/Manila
BACKUP_ACCESS_KEY_ID=
BACKUP_SECRET_ACCESS_KEY=
BACKUP_DEFAULT_REGION=auto
BACKUP_BUCKET=
BACKUP_ENDPOINT=
BACKUP_USE_PATH_STYLE_ENDPOINT=false
BACKUP_ARCHIVE_PASSWORD=
BACKUP_ALERT_EMAIL=
